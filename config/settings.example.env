# Copy to config/.env (or export in your shell) and fill in real values.
# Never commit real API keys.

# Optional: https://the-odds-api.com API key, only needed for scripts/find_value_bets.py
# (live odds comparison). All historical data/backtesting works without it.
ODDS_API_KEY=

# Which tours to track: atp, wta, or both (comma-separated)
TOURS=atp,wta

# First season of match history to pull (repo covers back to 1968)
START_SEASON=2010

# Optional: Telegram bot (scripts/run_telegram_bot.py). Create a bot with
# @BotFather on Telegram to get a token; everything else in this repo works
# without it.
TELEGRAM_BOT_TOKEN=
# Chat ID to push a daily rankings digest to (send the bot a message, then
# check https://api.telegram.org/bot<token>/getUpdates for your chat id).
# Leave empty to only answer commands, without the daily push.
TELEGRAM_CHAT_ID=
# Hour (UTC, 0-23) the daily digest is sent, if TELEGRAM_CHAT_ID is set.
TELEGRAM_DIGEST_HOUR_UTC=7

# Optional: automatic value-bet scanning. 0 (default) = disabled, only
# answers /valuebets on demand. Set to a number of minutes (e.g. 240 = every
# 4 hours) to have the bot scan in the background and push a message to
# TELEGRAM_CHAT_ID whenever it finds NEW candidates above the edge threshold
# (it won't repeat the same matchup/bookmaker every cycle).
# Needs ODDS_API_KEY and TELEGRAM_CHAT_ID both set. Mind your Odds API budget:
# free-tier keys are capped around 500 requests/month, and each scan costs
# one request per active tennis event -- 240 min (4x/day) is a safe default.
TELEGRAM_VALUEBETS_INTERVAL_MINUTES=0
# Minimum modelled edge vs. the de-vigged market to alert on (0.03 = 3%).
TELEGRAM_VALUEBETS_EDGE_THRESHOLD=0.03
