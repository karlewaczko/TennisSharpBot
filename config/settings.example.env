# Copy to config/.env (or export in your shell) and fill in real values.
# Never commit real API keys.

# Optional: https://the-odds-api.com API key, only needed for scripts/find_value_bets.py
# (live odds comparison). All historical data/backtesting works without it.
ODDS_API_KEY=

# Which tours to track: atp, wta, or both (comma-separated)
TOURS=atp,wta

# First season of match history to pull (repo covers back to 1968)
START_SEASON=2010
